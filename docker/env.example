# 复制成 <数据目录>/.env 后填写（docker run 的 --env-file / compose 的 env_file 读它）。
# 默认的数据目录：C:\Users\<你>\.horon\docker（Windows）或 ~/.horon/docker（Linux）。
# 不要提交、不要打进镜像。
# 两个都留空也能跑：只是 Jev（审计跑题判断、sensor 复筛）和 suggest_name 用不了。
OPENROUTER_API_KEY=
OPENCODE_GO_API_KEY=

# 代理默认不启用：填错了只会让容器连不上外网，而且错得很安静。确认需要时再打开，
# 端口填宿主机上真实的代理端口（NAS 上是 mihomo 的 7890，本机是 7897）。
# 容器内的 127.0.0.1 不是宿主机，所以走 host.docker.internal。
# HTTPS_PROXY=http://host.docker.internal:7890
# HTTP_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1
