{
  "name": "dsh-horon",
  "version": "1.0.2",
  "description": "Horon memory graph as a DeepSeek Harness plugin: the horon tool, lifecycle hooks, the console panel and a one-click service runtime (released artifact or Docker image)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guicaiyue/dsh-horon.git"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "harness.js",
    "client.js",
    "docker.js",
    "artifact.js",
    "horon_web_app.py",
    "horon.lock.json",
    "cordis.patch.yml",
    "scripts/bootstrap.py",
    "locale/*.json",
    "icon.svg",
    "skills/*/SKILL.md",
    "docker/Dockerfile",
    "docker/entrypoint.sh",
    "docker/requirements.lock.txt",
    "docker/env.example"
  ],
  "scripts": {
    "test": "node test/host-smoke.mjs",
    "assemble": "node scripts/assemble.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
